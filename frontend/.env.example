# ==============================================================================
# Pakistan Legal Rights Agent — Frontend Environment Configuration
# ==============================================================================
# Copy this template to .env.local for local development:
# cp .env.example .env.local

# API Base URL for FastAPI Backend
# Default points to local FastAPI server: http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Application Branding
VITE_APP_NAME=Pakistan Legal Rights Agent
VITE_APP_DESCRIPTION=AI-Powered Sindh Legal Information Assistant

# Offline / Standalone Development Mode
# Set to 'true' to test the full frontend experience with high-fidelity Sindh law mock responses
# Set to 'false' to route all requests directly to the FastAPI backend
VITE_ENABLE_MOCK_API=true

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=15000
