{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contact.schema.json",
  "title": "support_contacts.json - verified helplines, complaint cells and free legal aid",
  "description": "Every number must come from the organisation's own site (Level A) or an official government listing (Level B). Level C entries must have display = false. Show verified_on to users.",
  "type": "object",
  "required": ["dataset", "schema_version", "last_updated", "disclaimer", "levels", "contacts"],
  "properties": {
    "dataset": {"const": "support_contacts"},
    "schema_version": {"type": "string"},
    "last_updated": {"$ref": "#/$defs/date"},
    "maintainer": {"type": "string"},
    "disclaimer": {"type": "string"},
    "levels": {"type": "object", "additionalProperties": {"type": "string"}},
    "contacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contact"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "url": {"type": "string", "pattern": "^https?://"},
    "category": {
      "enum": ["employment", "harassment", "tenancy", "legal_aid", "human_rights", "government_complaints",
               "children", "cyber", "family", "women", "police", "emergency", "general"]
    },
    "source": {
      "type": "object",
      "required": ["url", "publisher", "kind"],
      "additionalProperties": false,
      "properties": {
        "url": {"$ref": "#/$defs/url"},
        "publisher": {"type": "string", "minLength": 1},
        "kind": {"enum": ["official_text", "official_page", "official_listing", "court", "org_own_site", "un_or_state_media", "secondary"]}
      }
    },
    "phone": {
      "type": "object",
      "required": ["number", "label"],
      "properties": {
        "number": {"type": "string", "pattern": "^[0-9][0-9-]*$", "description": "Digits and hyphens only, local format (e.g. 0800-70806, 021-99219920, 1099)."},
        "label": {"type": "string"},
        "toll_free": {"type": ["boolean", "null"], "description": "null = not stated by the source."},
        "hours": {"type": ["string", "null"], "description": "null = not stated by the source."},
        "note": {"type": "string"}
      }
    },
    "contact": {
      "type": "object",
      "required": ["id", "name", "type", "jurisdiction", "categories", "phones", "display", "verification"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string"},
        "also_known_as": {"type": "array", "items": {"type": "string"}},
        "type": {
          "enum": ["emergency", "government_helpline", "government_complaint_cell", "government_department", "government_service",
                   "ombudsperson", "statutory_commission", "law_enforcement", "police_liaison", "legal_aid_ngo",
                   "legal_aid_helpline", "legal_aid_mechanism", "ngo_helpline"]
        },
        "jurisdiction": {"enum": ["sindh", "federal", "federal_ict", "national"]},
        "categories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/category"}},
        "phones": {"type": "array", "items": {"$ref": "#/$defs/phone"}},
        "unverified_phones": {
          "description": "Numbers found but NOT confirmed on an official source (or contradicted by one). Never shown to users; listed first in CALL_CHECKLIST.md. Move into phones after a successful call-test.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["number", "label", "why_unverified"],
            "additionalProperties": false,
            "properties": {
              "number": {"type": "string", "pattern": "^[0-9][0-9-]*$"},
              "label": {"type": "string"},
              "why_unverified": {"type": "string", "minLength": 1}
            }
          }
        },
        "email": {"type": "array", "items": {"type": "string"}},
        "website": {"oneOf": [{"$ref": "#/$defs/url"}, {"type": "null"}]},
        "complaint_url": {"oneOf": [{"$ref": "#/$defs/url"}, {"type": "null"}]},
        "online_links": {"type": "array", "items": {"$ref": "#/$defs/url"}},
        "address": {"type": ["string", "null"]},
        "hours": {"type": ["string", "null"]},
        "services": {"type": "string"},
        "cost": {"type": ["string", "null"]},
        "related_law_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "how_to_access": {"type": "string"},
        "display": {"type": "boolean", "description": "false = keep for research, never show to users."},
        "priority_call_test": {"type": "boolean", "description": "true = something about this number needs a phone check before the demo."},
        "verification": {
          "type": "object",
          "required": ["level", "verified_on", "sources", "call_tested", "call_tested_on"],
          "properties": {
            "level": {"enum": ["A", "B", "C"]},
            "verified_on": {"$ref": "#/$defs/date"},
            "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
            "call_tested": {"type": "boolean"},
            "call_tested_on": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
            "notes": {"type": "string"}
          }
        }
      }
    }
  }
}
